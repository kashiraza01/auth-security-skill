{
  "name": "@auth-lab/constant-time-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Equalise the computational work of a credential check whether or not the account exists — a real mitigation for login timing/user-enumeration side channels. Not a random-sleep timer.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/verify.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "authentication",
    "timing-attack",
    "user-enumeration",
    "side-channel",
    "constant-time",
    "security"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tinybench": "^3.0.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
