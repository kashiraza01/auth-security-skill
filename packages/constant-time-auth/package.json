{
  "name": "@auth-lab/constant-time-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Constant-work login verification for Node.js — always performs one Argon2 verification, including when the account does not exist, to remove the timing signal that reveals whether an email is registered.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/verify.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "timing-attack",
    "user-enumeration",
    "authentication",
    "argon2",
    "constant-time",
    "login",
    "nodejs",
    "security"
  ],
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "tinybench": "^3.0.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
