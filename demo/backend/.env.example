# ---------------------------------------------------------------------------
# demo/backend/.env.example  —  copy to demo/backend/.env
# Run `npm run generate:secrets` to fill the HARDENED_* secrets with random values.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Leave empty for an ephemeral in-memory MongoDB (zero setup).
MONGO_URI=

# --- BASELINE stack secrets ------------------------------------------------
# Intentionally left blank. The baseline stack falls back to the literal string
# "dev-secret" when these are unset — which is exactly one of the demonstrated
# weaknesses (token forgery). Setting them here would "fix" the baseline and
# defeat the demo, so `generate:secrets` does NOT touch them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- HARDENED stack secrets ----------------------------------------------
# Required. The hardened stack throws on boot if either is missing, shorter than
# 32 chars, or equal to the other. `npm run generate:secrets` fills these.
HARDENED_JWT_ACCESS_SECRET=
HARDENED_JWT_REFRESH_SECRET=

# CORS: the hardened stack only accepts this exact origin (credentials mode).
# The baseline stack reflects any origin with credentials (a demonstrated weakness).
FRONTEND_URL=http://localhost:3000

# Token lifetimes (seconds). Baseline ignores these and hardcodes a 7-day access token.
HARDENED_ACCESS_TTL=900
HARDENED_REFRESH_TTL=1209600
