{
  "name": "@auth-lab/security-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Auth Security Skills Lab auditor wrapper — spawns the demo backend and runs the auth-security-breaker probe CLI against both auth stacks.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "audit": "node run.mjs",
    "audit:baseline": "node run.mjs --stack=baseline",
    "audit:hardened": "node run.mjs --stack=hardened"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "keywords": [
    "security-testing",
    "authentication",
    "audit",
    "user-enumeration",
    "timing-attack"
  ]
}
