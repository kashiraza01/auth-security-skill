# ---------------------------------------------------------------------------
# Auth Security Skill — root env example
# Copy to .env for local overrides. Every workspace also has its own .env.example.
# NEVER commit a real .env. NEVER put real secrets here.
# ---------------------------------------------------------------------------

# Backend
PORT=4000
NODE_ENV=development

# Mongo: leave MONGO_URI empty to use an ephemeral in-memory MongoDB (no setup).
# Set it to use a real database (e.g. the bundled docker-compose Mongo).
MONGO_URI=
# MONGO_URI=mongodb://localhost:27017/auth-security-skill

# JWT secrets. `npm run generate:secrets` fills the HARDENED_* pair (writes
# demo/backend/.env). The BASELINE pair is left blank on purpose — the baseline
# stack falls back to a hardcoded "dev-secret", which is a demonstrated finding.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
HARDENED_JWT_ACCESS_SECRET=
HARDENED_JWT_REFRESH_SECRET=

# CORS origin the hardened stack allows (baseline allows "*").
FRONTEND_URL=http://localhost:3000

# Security-test auditor: comma-separated extra hosts you are AUTHORISED to test.
# localhost / 127.0.0.1 / ::1 are always allowed. Anything else must be listed here.
AUTH_LAB_ALLOW_TARGET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
